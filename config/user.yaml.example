# Example User Overrides (Copy to user.yaml to customize)
version: "1.0"

wakeword:
  provider: "mock" # Or "openwakeword"

stt:
  provider: "mock" # Or "whisper_cpp", "faster_whisper", "openai"

llm:
  provider: "mock" # Or "ollama", "llama_cpp", "openai", "groq"
  model: "hermes3:3b"

tts:
  provider: "kokoro" # Or "piper", "edge_tts", "openai", "mock"
